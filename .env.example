# Copy to .env on the VPS and fill in. docker-compose reads this automatically.

# Postgres password for the dedicated kadmoon database (required).
POSTGRES_PASSWORD=change-this-to-a-long-random-string

# Salt used to hash lead IP addresses before storing (any long random string).
LEAD_IP_SALT=change-this-to-another-random-string

# --- Email notifications for new leads (first one set wins) ---
# Option A: Web3Forms. Get an access key at web3forms.com (tied to the email
# that should receive leads). The key stays server-side here, never exposed to
# the browser.
WEB3FORMS_ACCESS_KEY=
# Option B: Resend. Verify the kadmoon.com domain (also sets up SPF + DKIM),
# then paste the API key. CONTACT_FROM must be on the verified domain.
RESEND_API_KEY=
# Option C: SMTP (used only if the two above are empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
CONTACT_TO=comercial@kadmoon.com
# CONTACT_FROM defaults to the SMTP_USER address; set it if your provider
# requires a specific verified From address.
CONTACT_FROM=

# --- Odoo CRM (optional back-office integration) ---
# When all four are set, each website lead is also created as a crm.lead in
# Odoo. Leave empty to disable. Deploy the Odoo stack from deploy/odoo (see
# deploy/odoo/README.md). ODOO_URL is the reverse-proxied Odoo base URL.
# ODOO_API_KEY is a per-user API key (Odoo > Preferences > Account Security >
# New API Key), never a password.
ODOO_URL=
ODOO_DB=kadmoon
ODOO_LOGIN=
ODOO_API_KEY=

# --- Build-time only (optional) ---
# Google Tag Manager loads by default (container GTM-WK2T78RK, set in
# lib/site.ts). Only set this to override the container id.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
