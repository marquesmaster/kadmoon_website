# Copy to .env on the VPS and fill in. docker-compose reads this automatically.

# Postgres password for the dedicated kadmoon database (required).
POSTGRES_PASSWORD=change-this-to-a-long-random-string

# Salt used to hash lead IP addresses before storing (any long random string).
LEAD_IP_SALT=change-this-to-another-random-string

# --- Email notifications for new leads ---
# Option A (recommended): Resend. Create an account, verify the kadmoon.com
# domain (which also sets up SPF + DKIM), and paste the API key. CONTACT_FROM
# must be an address on the verified domain.
RESEND_API_KEY=
# Option B: SMTP (used only if RESEND_API_KEY is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
CONTACT_TO=comercial@kadmoon.com
# CONTACT_FROM defaults to the SMTP_USER address; set it if your provider
# requires a specific verified From address.
CONTACT_FROM=

# --- Build-time only (optional) ---
# Google Tag Manager loads by default (container GTM-WK2T78RK, set in
# lib/site.ts). Only set this to override the container id.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
